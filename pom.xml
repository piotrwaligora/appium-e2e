<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.piotrwaligora</groupId>
    <artifactId>appium-e2e</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Appium E2E</name>
    <description>Mobile test automation framework for Android and iOS</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <appium-java-client.version>11.0.0</appium-java-client.version>
        <selenium.version>4.54.0</selenium.version>
        <testng.version>7.12.0</testng.version>
        <assertj.version>3.27.7</assertj.version>
        <allure.version>3.1.1</allure.version>

        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <allure-maven.version>3.2.0</allure-maven.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                java-client declares Selenium as a version range. The BOM pins one version,
                which makes builds reproducible and avoids range lookups on Maven Central.
            -->
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-bom</artifactId>
                <version>${selenium.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>${appium-java-client.version}</version>
        </dependency>
        <dependency>
            <!-- WebDriverWait / FluentWait; version from the Selenium BOM -->
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
        </dependency>
        <dependency>
            <!-- Allure.step and attachments from the framework code; no AspectJ agent needed -->
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-java-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <!-- Runs the tests in mvn test; the IDE runs TestNG directly -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- Short failure traces in the console (test class frames only); full ones stay in surefire-reports -->
                    <trimStackTrace>true</trimStackTrace>
                    <systemPropertyVariables>
                        <!-- No logging backend is used on purpose; silence the SLF4J "no providers" notice -->
                        <slf4j.internal.verbosity>ERROR</slf4j.internal.verbosity>
                    </systemPropertyVariables>
                    <properties>
                        <!-- Registered here, not in testng.xml, so that it also works with -Dtest=... -->
                        <property>
                            <name>listener</name>
                            <value>io.github.piotrwaligora.e2e.listeners.RetryTransformer</value>
                        </property>
                    </properties>
                </configuration>
            </plugin>
            <plugin>
                <!-- mvn allure:serve (opens the report) or mvn allure:report (target/site/allure-maven-plugin) -->
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <configuration>
                    <resultsDirectory>allure-results</resultsDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
